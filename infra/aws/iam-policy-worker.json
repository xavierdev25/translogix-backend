{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeDocumentJobs",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:SendMessage"
      ],
      "Resource": "${QUEUE_ARN}"
    },
    {
      "Sid": "SweepDeadLetters",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "${DLQ_ARN}"
    }
  ]
}
