meta {
  name: Retenido TLX-310482-CO
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/tracking/{{guiaRetenida}}
  body: none
  auth: none
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
  test("estado_actual.codigo = RETENIDO_NOVEDAD", () => expect(res.body?.["estado_actual"]?.["codigo"]).to.eql("RETENIDO_NOVEDAD"));
  test("flags.mercancia_peligrosa = True", () => expect(res.body?.["flags"]?.["mercancia_peligrosa"]).to.eql(true));
}
