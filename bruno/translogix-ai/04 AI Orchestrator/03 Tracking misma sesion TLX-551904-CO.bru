meta {
  name: Tracking misma sesion TLX-551904-CO
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/chat/messages
  body: json
  auth: none
}

body:json {
  {
    "client_id": "{{clientId}}",
    "message_id": "{{messageId}}",
    "text": "TLX-551904-CO",
    "session_id": "{{sessionId}}"
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
  if (!bru.getVar("clientId")) bru.setVar("clientId", uuid());
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
  test("reply.session_id = {{sessionId}}", () => expect(res.body?.["reply"]?.["session_id"]).to.eql(bru.getVar("sessionId")));
  test("reply.meta.intent = TRACKING", () => expect(res.body?.["reply"]?.["meta"]?.["intent"]).to.eql("TRACKING"));
}
