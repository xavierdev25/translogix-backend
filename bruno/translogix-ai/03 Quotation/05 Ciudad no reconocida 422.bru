meta {
  name: Ciudad no reconocida (422)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/cotizar
  body: json
  auth: none
}

body:json {
  {
    "origen": "Bogotá D.C.",
    "destino": "Gotham",
    "alto_cm": 40,
    "ancho_cm": 50,
    "largo_cm": 60,
    "peso_real_kg": 45.5,
    "valor_declarado_cop": 12500000,
    "requiere_cadena_frio": false,
    "mercancia_peligrosa": false
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
}

tests {
  test("HTTP 422", () => expect(res.status).to.equal(422));
  test("error.code = CIUDAD_NO_RECONOCIDA", () => expect(res.body?.["error"]?.["code"]).to.eql("CIUDAD_NO_RECONOCIDA"));
}
