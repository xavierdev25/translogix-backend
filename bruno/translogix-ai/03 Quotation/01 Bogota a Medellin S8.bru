meta {
  name: Bogota a Medellin (S8)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/cotizar
  body: json
  auth: none
}

body:json {
  {
    "origen": "Bogotá D.C.",
    "destino": "Medellín",
    "alto_cm": 40,
    "ancho_cm": 50,
    "largo_cm": 60,
    "peso_real_kg": 45.5,
    "valor_declarado_cop": 12500000,
    "requiere_cadena_frio": false,
    "mercancia_peligrosa": false
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
  test("calculo.flete_total_cop = 190975", () => expect(res.body?.["calculo"]?.["flete_total_cop"]).to.eql(190975));
  test("formula_version = provisional-v1", () => expect(res.body?.["formula_version"]).to.eql("provisional-v1"));
}
