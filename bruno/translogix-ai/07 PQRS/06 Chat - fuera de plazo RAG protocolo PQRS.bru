meta {
  name: Chat - fuera de plazo (RAG protocolo PQRS)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/chat/messages
  body: json
  auth: none
}

body:json {
  {
    "client_id": "{{clientId}}",
    "message_id": "{{messageId}}",
    "text": "Hace un mes me entregaron un envío y hasta hoy lo abrí y vi que falta la mitad de las cosas. Exijo indemnización."
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
  bru.setVar("clientId", uuid());
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
  test("reply.meta.intent = PQRS", () => expect(res.body?.["reply"]?.["meta"]?.["intent"]).to.eql("PQRS"));
}
