meta {
  name: Reindexar corpus (admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/rag/reindex
  body: json
  auth: none
}

headers {
  X-Admin-Token: {{adminToken}}
}

body:json {
  {
    "force": false
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
  test("status = COMPLETED", () => expect(res.body?.["status"]).to.eql("COMPLETED"));
  test("embed_dim = 1024", () => expect(res.body?.["embed_dim"]).to.eql(1024));
}
