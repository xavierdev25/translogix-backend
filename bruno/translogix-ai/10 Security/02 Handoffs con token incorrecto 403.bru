meta {
  name: Handoffs con token incorrecto (403)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/handoffs
  body: none
  auth: none
}

headers {
  X-Admin-Token: token-incorrecto-123456
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
}
