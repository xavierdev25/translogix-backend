meta {
  name: Reindex sin token (403)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/rag/reindex
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
  test("error.code = NO_AUTORIZADO", () => expect(res.body?.["error"]?.["code"]).to.eql("NO_AUTORIZADO"));
}
