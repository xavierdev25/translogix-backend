meta {
  name: Amenaza legal - CRIT-002
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/chat/messages
  body: json
  auth: none
}

body:json {
  {
    "client_id": "{{clientId}}",
    "message_id": "{{messageId}}",
    "text": "Pésimo servicio, voy a demandar ante la Supertransporte"
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
  bru.setVar("messageId", uuid());
  bru.setVar("clientId", uuid());
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
  test("reply.meta.escalation.primary.id_criterio = CRIT-002", () => expect(res.body?.["reply"]?.["meta"]?.["escalation"]?.["primary"]?.["id_criterio"]).to.eql("CRIT-002"));
}
