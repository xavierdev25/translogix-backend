# Nombres canónicos (§9 del contrato; app/contracts/env.py). Copiar a .env.
# Solo marcadores: ningún valor real vive en el repositorio. Los valores no secretos
# que fija el contrato se incluyen tal cual.

DATABASE_URL=<postgresql+asyncpg://usuario:contraseña@host:5432/translogix>
OLLAMA_BASE_URL=<http://localhost:11434>
OLLAMA_CHAT_MODEL=<modelo-de-chat>
OLLAMA_EMBED_MODEL=<modelo-de-embeddings>
EMBED_DIM=<dimensión del modelo de embeddings>
RAG_TOP_K=<entero>
CONFIDENCE_THRESHOLD=0.75
CRIT003_MODE=claim_context
CRIT005_MODE=incident_context
INSURANCE_MIN_SOURCE=pdf
HANDOFF_WAIT_SECONDS=45
SESSION_TTL_MINUTES_WEB_CHAT=<minutos>
SESSION_TTL_MINUTES_WHATSAPP=<minutos>
SESSION_TTL_MINUTES_PBX=<minutos>
IDLE_REMINDER_MINUTES_WEB_CHAT=5
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_MODE=SIMULATED
PBX_MODE=SIMULATED
ADMIN_TOKEN=
PII_HASH_SALT=
BUSINESS_HOLIDAYS_FILE=<ruta a JSON de festivos; vacío = sin festivos>
LOG_LEVEL=INFO
CLOCK_OVERRIDE=<ISO-8601 con offset; vacío = reloj del sistema>
BATCH_MAX_ITEMS=500
BATCH_MAX_BODY_BYTES=2097152
BATCH_RATE_LIMIT_PER_MINUTE=10
BATCH_LEASE_SECONDS=60
TARIFF_ENVIRONMENT=TEST_ONLY
# 2.0.0 (CR-010): claves Fernet separadas por comas; la primera cifra, todas descifran (rotación).
# Generar con: uv run python -m app.privacy.cli generate-key. Nunca en el repositorio.
PII_ENCRYPTION_KEYS=
# 2.1.0 (CR-011): AWS híbrido. Las credenciales AWS nunca van aquí: rol IAM o perfil (~/.aws).
# local = var/attachments; s3 = bucket privado con SSE-KMS (requiere S3_BUCKET y S3_KMS_KEY_ID).
ATTACHMENTS_STORAGE=local
AWS_REGION=<región, p. ej. us-east-1; vacío = la del perfil>
S3_BUCKET=<nombre del bucket privado; vacío = sin S3>
S3_KMS_KEY_ID=<ARN o alias de la clave KMS gestionada por el cliente>
# disabled = la reindexación RAG es síncrona (como antes); sqs = acepta modo asíncrono.
JOBS_BACKEND=disabled
SQS_QUEUE_URL=<URL de la cola Standard de trabajos documentales>
SQS_DLQ_URL=<URL de la DLQ asociada>
METRICS_NAMESPACE=TransLogix
