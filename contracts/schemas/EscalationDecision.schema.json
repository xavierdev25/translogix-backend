{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EscalationDecision.schema.json",
  "title": "EscalationDecision",
  "x-contract-version": "2.1.0",
  "$defs": {
    "EscalationAction": {
      "enum": [
        "ESCALAR_A_HUMANO",
        "ESCALAR_PRIORIDAD_ALTA",
        "ESCALAR_A_DEPARTAMENTO_JURIDICO_Y_PQRS",
        "ESCALAR_A_EJECUTIVO_CUENTA_DEDICADO",
        "ESCALAR_URGENCIA_OPERACIONES",
        "OFRECER_HANDOFF"
      ],
      "title": "EscalationAction",
      "type": "string"
    },
    "EscalationTrigger": {
      "additionalProperties": false,
      "properties": {
        "id_criterio": {
          "enum": [
            "CRIT-001",
            "CRIT-002",
            "CRIT-003",
            "CRIT-004",
            "CRIT-005",
            "INFO-INTENTOS"
          ],
          "title": "Id Criterio",
          "type": "string"
        },
        "accion": {
          "$ref": "#/$defs/EscalationAction"
        },
        "accion_raw": {
          "description": "Acción tal como aparece en el JSON de reglas.",
          "title": "Accion Raw",
          "type": "string"
        },
        "evidencia": {
          "description": "Qué dato disparó la regla, sin PII.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Evidencia",
          "type": "string"
        },
        "modo": {
          "examples": [
            "claim_context",
            "incident_context",
            "literal"
          ],
          "title": "Modo",
          "type": "string"
        }
      },
      "required": [
        "id_criterio",
        "accion",
        "accion_raw",
        "evidencia",
        "modo"
      ],
      "title": "EscalationTrigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "escalate": {
      "title": "Escalate",
      "type": "boolean"
    },
    "primary": {
      "anyOf": [
        {
          "$ref": "#/$defs/EscalationTrigger"
        },
        {
          "type": "null"
        }
      ]
    },
    "triggers": {
      "items": {
        "$ref": "#/$defs/EscalationTrigger"
      },
      "title": "Triggers",
      "type": "array"
    },
    "mensaje_cliente": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Texto del JSON para el criterio primario.",
      "title": "Mensaje Cliente"
    },
    "rules_version": {
      "default": "1.0.2026",
      "title": "Rules Version",
      "type": "string"
    },
    "config_snapshot": {
      "additionalProperties": {
        "type": "string"
      },
      "examples": [
        {
          "CRIT003_MODE": "claim_context",
          "CRIT005_MODE": "incident_context"
        }
      ],
      "title": "Config Snapshot",
      "type": "object"
    }
  },
  "required": [
    "escalate",
    "primary",
    "triggers",
    "mensaje_cliente",
    "rules_version",
    "config_snapshot"
  ],
  "type": "object"
}
